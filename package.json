{
  "name": "jays-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean-start": "lsof -ti:3000 | xargs kill -9 2>/dev/null; npm run dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "DATABASE_URL=file:./prisma/dev.db npx tsx prisma/reset-data.ts",
    "db:reset-full": "rm -f prisma/dev.db && DATABASE_URL=file:./prisma/dev.db npx prisma db push --force-reset && DATABASE_URL=file:./prisma/dev.db npx tsx prisma/seed.ts",
    "db:clear-products": "tsx prisma/clear-products.ts",
    "media:audit": "tsx scripts/media-audit.ts",
    "media:cleanup": "tsx scripts/media-audit.ts --execute"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "14.2.29",
    "next-auth": "^4.24.10",
    "next-pwa": "^5.6.0",
    "openai": "^4.72.0",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.15.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.4",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
