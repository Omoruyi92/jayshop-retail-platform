# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Database ─────────────────────────────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# https://cloudinary.com → Dashboard → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Create an unsigned upload preset named "jays-shop-unsigned" in Cloudinary settings
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=jays-shop-unsigned

# ─── Slack ────────────────────────────────────────────────────────────────────
# Create an incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX
# For interactive button callbacks (optional):
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ─── OpenAI (Birdie chatbot) ──────────────────────────────────────────────────
# https://platform.openai.com/api-keys
# Model: gpt-4o-mini  |  Cost: ~$0.08–$0.40 per 1,000 chats
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── Cron Security ────────────────────────────────────────────────────────────
# Random secret that Vercel Cron sends in the Authorization header
# Generate: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
