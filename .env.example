# ─────────────────────────────────────────────────────────────────────────────
# Jays Shop — Environment Variables
# Copy this file to `.env.local` for local development and fill in real values.
# Never commit `.env` / `.env.local` (they are gitignored) or paste secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
# Self-hosted Postgres 16 (see docker-compose.yml — run via Docker/Colima).
# Local dev default matches docker-compose.yml: user "jays", db "jays_shop".
# In production (Vercel), point this at your managed Postgres instance
# (e.g. Neon, Supabase, RDS, Railway) — any standard Postgres connection string works.
DATABASE_URL=postgresql://jays:jays@localhost:5432/jays_shop

# ─── Auth (NextAuth) ──────────────────────────────────────────────────────────
# Base URL of the app, used by NextAuth for callback URLs.
# Local: http://localhost:3000  |  Production: your deployed Vercel URL.
NEXTAUTH_URL=http://localhost:3000
# Secret used to sign/encrypt NextAuth JWTs. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── App URL ──────────────────────────────────────────────────────────────────
# Public base URL used in generated links (e.g. hold QR codes, print pages).
# Local: http://localhost:3000  |  Production: your deployed Vercel URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Media / Uploads ──────────────────────────────────────────────────────────
# No env vars required. Uploaded images are optimized in-process with `sharp`
# and written to `public/uploads/` on the server's local filesystem
# (see src/lib/media/optimizeImage.ts). No external image host is used.

# ─── Slack Notifications (optional) ───────────────────────────────────────────
# The primary webhook URL is normally configured per-store via the admin
# dashboard (Admin → Notifications, stored in the SlackSettings DB table).
# This env var is a fallback used only by src/lib/slack.ts when no DB row
# exists yet. Create an incoming webhook at:
#   https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Required only if using Slack's interactive buttons (Mark Picked Up / Release)
# on hold notifications. Get it from your Slack app's "Basic Information" page
# (Signing Secret), used to verify inbound /api/slack/interactive requests.
SLACK_SIGNING_SECRET=

# ─── AI Chat — Birdie assistant (optional) ────────────────────────────────────
# If unset, the chatbot falls back to canned/rule-based replies (no cost, no
# external call — see src/app/api/chat/route.ts). Set this to enable live
# GPT-4o-mini responses grounded in the current product catalog.
# Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Cron / Scheduled Jobs ─────────────────────────────────────────────────────
# Shared secret that Vercel Cron sends in the Authorization header when
# calling /api/cron/expire-holds (see vercel.json for the schedule).
# Generate: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here
