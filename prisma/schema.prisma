generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  products  Product[]
  locations StoreLocation[]
  admins    Admin[]
  players   Player[]

  @@index([slug])
  @@index([isDefault])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryChildren")
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  // Merchandising priority bucket used to order products on the default,
  // unfiltered Shop catalog view (e.g. Jerseys=1, Hats=2, Fleece=3,
  // Accessories=4). Null means "no priority bucket" and sorts last.
  // Distinct from sortOrder, which only controls sibling display order
  // within the admin category tree / nav, not cross-category product sort.
  sortPriority Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  productTypes    CategoryProductType[]
  categoryBrands  CategoryBrand[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([isActive])
}

// Admin-managed "Type" options (e.g. Jerseys, Fleece, Hats) scoped to a
// top-level Category. Replaces the previously hardcoded
// PRODUCT_TYPES_BY_CAT constant so admins can add/remove/rename types
// without a code deploy.
model CategoryProductType {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
}

// Join table assigning existing global Brand records to a top-level
// Category, replacing the previously hardcoded BRANDS_BY_CAT constant.
model CategoryBrand {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([categoryId, brandId])
  @@index([categoryId])
  @@index([brandId])
}

model Product {
  id                 String                 @id @default(cuid())
  name               String
  slug               String                 @unique
  description        String?
  priceCents         Int
  imageUrl           String
  category           String                 @default("accessories")
  subcategory        String                 @default("")
  ageGroup           String                 @default("")
  audience           String                 @default("")
  productType        String                 @default("")
  hatStyle           String                 @default("")
  quantity           Int                    @default(1)
  heldQuantity       Int                    @default(0)
  pickedQuantity     Int                    @default(0)
  sizes              String                 @default("")
  brand              String                 @default("")
  status             String                 @default("AVAILABLE")
  isLicensed         Boolean                @default(false)
  isChampion         Boolean                @default(false)
  isBestSeller       Boolean                @default(false)
  isClearance        Boolean                @default(false)
  tenantId           String
  material           String                 @default("")
  careInstructions   String                 @default("")
  sku                String?
  highlights         String                 @default("")
  imageUrl2          String                 @default("")
  imageUrl3          String                 @default("")
  isFeatured         Boolean                @default(false)
  isNewArrival       Boolean                @default(false)
  isSport            Boolean                @default(false)
  isWorldSeries      Boolean                @default(false)
  colors             Json?
  originalPriceCents Int?
  salePriceCents     Int                    @default(0)
  isBlankJersey      Boolean                @default(false)
  isCityConnect      Boolean                @default(false)
  isChampionshipGear Boolean                @default(false)
  holdEnabled        Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  holds              Hold[]
  sizeInventories    SizeInventory[]
  transactions       InventoryTransaction[]
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  players            PlayerProduct[]
  likes              ProductLike[]
  reviews            ProductReview[]
  customerPhotos     CustomerPhoto[]
  styleSubmissions   CustomerStyleSubmission[]
  styles             ProductStyle[]

  @@index([status])
  @@index([category])
  @@index([brand])
  @@index([isBlankJersey])
  @@index([tenantId])
  @@index([tenantId, slug])
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String   @unique
  createdAt DateTime @default(now())
  holds     Hold[]

  @@index([phone])
}

model Hold {
  id                   String    @id @default(cuid())
  reservationCode      String    @unique
  productId            String
  customerId           String
  customerNameSnapshot String    @default("")
  size                 String?
  holdQuantity         Int       @default(1)
  totalPriceCents      Int       @default(0)
  status               String    @default("ACTIVE")
  placedAt             DateTime  @default(now())
  expiresAt            DateTime
  pickedUpAt           DateTime?
  releasedAt           DateTime?
  notifiedStaffAt      DateTime?
  isStadiumHold        Boolean   @default(false)
  pickupQueueAt        DateTime?
  queuePosition        Int?
  customer             Customer  @relation(fields: [customerId], references: [id])
  product              Product   @relation(fields: [productId], references: [id])

  @@index([productId, status])
  @@index([status, expiresAt])
  @@index([customerId])
}

model SizeInventory {
  id             String        @id @default(cuid())
  productId      String
  size           String
  quantity       Int           @default(0)
  heldQuantity   Int           @default(0)
  pickedQuantity Int           @default(0)
  locationId     String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  location       StoreLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, size, locationId])
  @@index([locationId, productId])
}

model StoreLocation {
  id               String                 @id @default(cuid())
  code             String                 @unique
  name             String
  section          String?
  gate             String?
  isMainStore      Boolean                @default(false)
  isPickupQueue    Boolean                @default(false)
  active           Boolean                @default(true)
  sortOrder        Int                    @default(0)
  tenantId         String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  sizeInventories  SizeInventory[]
  transactionsFrom InventoryTransaction[] @relation("TransactionFrom")
  transactionsTo   InventoryTransaction[] @relation("TransactionTo")
  posApiKeys       PosApiKey[]
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([active])
  @@index([tenantId])
  @@index([tenantId, code])
}

model InventoryTransaction {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           String?
  type           String // 'transfer' | 'adjustment' | 'sale' | 'return' | 'hold-reserve' | 'hold-release' | 'assign' | 'remove'
  quantity       Int // signed for adjustments; positive delta for the destination
  fromLocationId String?
  fromLocation   StoreLocation? @relation("TransactionFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     StoreLocation? @relation("TransactionTo", fields: [toLocationId], references: [id])
  actorId        String?
  actorEmail     String?
  note           String?
  createdAt      DateTime       @default(now())

  @@index([productId, createdAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([type, createdAt])
}

model Admin {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  role              AdminRole      @default(STAFF)
  tenantId          String
  passwordUpdatedAt DateTime       @default(now())
  createdAt         DateTime       @default(now())
  auditLogs         AuditLog[]
  resolvedHolds     HoldHistory[]
  sales             SalesHistory[]
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
  VIEWER
}

model SlackSettings {
  id                 String  @id @default(cuid())
  webhookUrl         String
  channelName        String
  interactiveEnabled Boolean @default(false)
}

model HoldHistory {
  id                        String    @id @default(cuid())
  holdId                    String?   @unique
  reservationCode           String
  productId                 String?
  productNameSnapshot       String
  productBrandSnapshot      String    @default("")
  productPriceCentsSnapshot Int
  productImageUrlSnapshot   String
  customerId                String?
  customerNameSnapshot      String
  customerPhoneSnapshot     String
  holdQuantity              Int       @default(1)
  fulfilledQuantity         Int       @default(1)
  totalPriceCentsSnapshot   Int       @default(0)
  finalTotalCents           Int       @default(0)
  placedAt                  DateTime
  expiresAt                 DateTime
  finalStatus               String
  resolvedAt                DateTime
  resolvedByAdminId         String?
  notes                     String?
  archivedAt                DateTime?
  resolvedBy                Admin?    @relation(fields: [resolvedByAdminId], references: [id])

  @@index([finalStatus])
  @@index([resolvedAt])
  @@index([customerPhoneSnapshot])
  @@index([productId])
  @@index([resolvedByAdminId])
  @@index([archivedAt])
}

model SalesHistory {
  id                     String   @id @default(cuid())
  holdId                 String
  reservationCode        String
  productId              String?
  productNameSnapshot    String
  salePriceCentsSnapshot Int
  holdQuantity           Int      @default(1)
  fulfilledQuantity      Int      @default(1)
  customerId             String?
  customerPhoneSnapshot  String
  soldAt                 DateTime
  soldByAdminId          String?
  soldBy                 Admin?   @relation(fields: [soldByAdminId], references: [id])

  @@index([soldAt])
  @@index([soldByAdminId])
  @@index([productId])
  @@index([customerPhoneSnapshot])
}

model HoldSettings {
  id                String   @id @default(cuid())
  enable48HourHold  Boolean  @default(true)
  standardHoldHours Int      @default(4)
  extendedHoldHours Int      @default(48)
  updatedAt         DateTime @updatedAt
  updatedById       String?
}

model GameDay {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  opponent  String?
  note      String?
  startTime String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  action     String
  entityType String
  entityId   String
  actorId    String?
  actorType  String?
  actorEmail String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  note       String?
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())
  actor      Admin?   @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

/// Phase 9: POS integration API keys. Raw key is shown once at creation time
/// and only its bcrypt hash is ever persisted.
model PosApiKey {
  id         String         @id @default(cuid())
  name       String
  keyHash    String         @unique
  locationId String?
  location   StoreLocation? @relation(fields: [locationId], references: [id])
  active     Boolean        @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())
  createdBy  String?
  events     PosEvent[]

  @@index([active])
}

/// Phase 9: append-only audit log of every POST /api/pos/transaction call,
/// keyed by the POS-provided externalId for idempotency.
model PosEvent {
  id          String     @id @default(cuid())
  externalId  String     @unique
  type        String
  locationId  String?
  payload     Json
  status      String     @default("applied") // applied | rejected | deduped
  errorReason String?
  apiKeyId    String?
  apiKey      PosApiKey? @relation(fields: [apiKeyId], references: [id])
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  imageUrl  String   @default("")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  categoryLinks CategoryBrand[]

  @@index([slug])
  @@index([status])
}

model CustomerNotification {
  id          String                        @id @default(cuid())
  type        String                        @default("NEW_ARRIVAL")
  title       String
  body        String
  productId   String?
  productSlug String?
  imageUrl    String?
  createdAt   DateTime                      @default(now())
  receipts    CustomerNotificationReceipt[]

  @@index([productId])
  @@index([type, createdAt])
}

model CustomerNotificationReceipt {
  id             String               @id @default(cuid())
  notificationId String
  customerId     String
  isRead         Boolean              @default(false)
  isOpened       Boolean              @default(false)
  openedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  notification   CustomerNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, customerId])
  @@index([customerId, expiresAt])
  @@index([customerId, isRead])
}

model Player {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  jerseyNumber String          @default("")
  position     String          @default("")
  bio          String          @default("")
  heroImageUrl String
  imageUrls    String          @default("")
  stats        Json?
  isFeatured   Boolean         @default(false)
  isTrending   Boolean         @default(false)
  isNewArrival Boolean         @default(false)
  status       String          @default("ACTIVE")
  sortOrder    Int             @default(0)
  tenantId     String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products     PlayerProduct[]

  @@index([isFeatured])
  @@index([isTrending])
  @@index([status])
  @@index([tenantId])
}

model PlayerProduct {
  id        String   @id @default(cuid())
  playerId  String
  productId String
  label     String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([playerId, productId])
  @@index([playerId])
  @@index([productId])
}

model ProductLike {
  id        String   @id @default(cuid())
  productId String
  sessionId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sessionId])
  @@index([createdAt])
  @@index([productId])
}

model ProductReview {
  id           String    @id @default(cuid())
  productId    String
  customerName String
  rating       Int
  comment      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  moderatedAt  DateTime?
  moderatedBy  String?
  status       String    @default("PENDING")
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([productId, status])
  @@index([rating])
  @@index([status])
}

model PromotionMessage {
  id         String    @id @default(cuid())
  text       String
  link       String?   @default("")
  status     String    @default("PENDING")
  priority   Int       @default(0)
  startsAt   DateTime?
  expiresAt  DateTime?
  approvedBy String?
  approvedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([createdAt])
  @@index([expiresAt])
  @@index([status, priority])
}

model SiteFeedback {
  id          String    @id @default(cuid())
  name        String?
  message     String
  createdAt   DateTime  @default(now())
  moderatedAt DateTime?
  moderatedBy String?
  status      String    @default("PENDING")

  @@index([createdAt])
  @@index([status])
}

model StoreGalleryImage {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("General")
  imageUrl    String
  sortOrder   Int      @default(0)
  status      String   @default("ACTIVE")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, status])
  @@index([createdAt])
  @@index([status, sortOrder])
}

model CustomerPhoto {
  id               String   @id @default(cuid())
  productId        String
  imageUrl         String
  caption          String?
  customerName     String?
  instagramHandle  String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([status])
  @@index([createdAt])
}

model HeroSlide {
  id          String     @id @default(cuid())
  scope       SlideScope @default(HOME)
  mediaType   MediaType  @default(IMAGE)
  url         String
  mobileUrl   String?
  altText     String?
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([scope, active, sortOrder])
  @@index([active])
  @@index([createdAt])
}

model CustomerStyleSubmission {
  id              String                @id @default(cuid())
  productId       String
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  instagramHandle String?
  caption         String?
  status          SubmissionStatus      @default(PENDING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  images          CustomerStyleImage[]
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([productId, status])
  @@index([createdAt])
}

model CustomerStyleImage {
  id           String                  @id @default(cuid())
  submissionId String
  imageUrl     String
  caption      String?
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  submission   CustomerStyleSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([createdAt])
}

// "Shop by Style" landing page category (e.g. Jerseys, Streetwear, Game Day
// Fits, Jackets, Hats, Hoodies). Distinct from Category (product taxonomy) —
// this is a customer-facing merchandising concept used to build masonry
// cards on the Style landing page and a style-filtered listing page.
model StyleCategory {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  coverImageUrl   String
  heroImageUrl    String?
  heroVideoUrl    String?
  heroOverlayText String?
  heroCtaLabel    String?
  heroCtaUrl      String?
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  products        ProductStyle[]

  @@index([isActive, sortOrder])
  @@index([slug])
}

// Many-to-many join between Product and StyleCategory — a product may
// reasonably belong to more than one style (e.g. a jersey could be both
// "Jerseys" and "Game Day Fits").
model ProductStyle {
  id              String        @id @default(cuid())
  productId       String
  styleCategoryId String
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  styleCategory   StyleCategory @relation(fields: [styleCategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, styleCategoryId])
  @@index([productId])
  @@index([styleCategoryId])
}

enum SlideScope {
  HOME
  SHOP
  STYLE_LANDING
  PLAYERS
  GALLERY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
